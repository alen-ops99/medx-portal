# Stripe — Card payment processing
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret from: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# FIRA Finance — Croatian fiscal invoicing (fiskalizacija)
# Get your API key from: https://app.fira.finance → Settings → Webshop → Custom webshop
FIRA_API_KEY=
FIRA_API_URL=https://app.fira.finance

# Med&X Bank Details (for bank transfer instructions)
MEDX_IBAN=HR1234567890123456789
MEDX_BANK_NAME=Zagrebačka banka d.d.
MEDX_SWIFT=ZABAHR2X
MEDX_COMPANY_NAME=Med&X
MEDX_VAT_ID=HR12345678901
MEDX_ADDRESS=Zagreb, Croatia

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Med&X Accelerator <accelerator@medx.hr>

# Google Wallet — event tickets (optional; leave GOOGLE_WALLET_SA_KEY empty to disable cleanly).
# Issuer id + approved event-ticket class id are public; the service-account JSON is a secret.
# Create the issuer at pay.google.com/business/console and the service account in Google Cloud
# (grant it the Wallet Object Issuer role). Paste the WHOLE service-account JSON as one line.
GOOGLE_WALLET_ISSUER_ID=3388000000023175280
GOOGLE_WALLET_EVENT_CLASS_ID=3388000000023175280.3388000000023175280.plexus_week_2026
GOOGLE_WALLET_SA_KEY=
# Apple Wallet (future — needs a $99/yr Apple Pass Type ID cert; leave empty for now)
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_PASS_TYPE_ID=

# Server
PORT=3000
# Generate a strong random value, e.g.  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
